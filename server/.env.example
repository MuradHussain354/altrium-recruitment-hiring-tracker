PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/altrium_recruitment?schema=public"
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Initial Manager Bootstrap (Placeholders Only)
INITIAL_MANAGER_NAME="System Manager"
INITIAL_MANAGER_EMAIL="REPLACE_WITH_MANAGER_EMAIL"
INITIAL_MANAGER_PASSWORD="REPLACE_WITH_SECURE_PASSWORD"

# Frontend Allowed Origin (Production CORS + invitation/unsubscribe links).
# Single source of truth for the public frontend URL used across the app —
# email templates (invitation, job alert unsubscribe, dashboard links) read
# this same variable rather than a second, conflicting one.
FRONTEND_URL=http://localhost:5173

# Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Sprint 2 Batch 4: Email Outbox & Account Invitations ────────────────────

# Dedicated AES-256-GCM key for encrypting durable-outbox email tokens
# (account invitation tokens). Must be either 64 hex characters (32 bytes) or
# a raw 32-character UTF-8 string.
EMAIL_TOKEN_ENCRYPTION_KEY=your_dedicated_32_byte_or_64_hex_email_token_key_change_in_production

# Resend (https://resend.com) transactional email provider. If unset (or in
# NODE_ENV=test), the outbox falls back to MockProviderAdapter and no real
# emails are sent.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Altrium Careers <onboarding@resend.dev>"

# Base URL used to build links inside outgoing emails (job alerts, digest
# dashboard link). Distinct from FRONTEND_URL only if the public marketing/App
# origin differs from the CORS-allowed frontend origin; otherwise set both to
# the same value.
PUBLIC_APP_URL=http://localhost:5173

# How long (ms) an EmailDeliveryLog may sit in "Sending" before the outbox
# sweeper treats the worker as crashed and reclaims the record for retry.
OUTBOX_SENDING_TIMEOUT_MS=300000

# IANA timezone used to schedule the weekly Monday 08:00 hiring digest
# (S2-27). Defaults to Asia/Colombo when unset.
APP_TIMEZONE=Asia/Colombo
