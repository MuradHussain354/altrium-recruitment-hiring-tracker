PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/altrium_recruitment?schema=public"
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
TWO_FACTOR_ENCRYPTION_KEY=your_32_byte_or_64_hex_encryption_key_change_in_production

# Initial Manager Bootstrap (Placeholders Only)
INITIAL_MANAGER_NAME="System Manager"
INITIAL_MANAGER_EMAIL="REPLACE_WITH_MANAGER_EMAIL"
INITIAL_MANAGER_PASSWORD="REPLACE_WITH_SECURE_PASSWORD"

# Frontend Allowed Origin (Production CORS)
FRONTEND_URL=http://localhost:5173

# Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
