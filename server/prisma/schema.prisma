// Prisma Schema Definition for Altrium Recruitment & Hiring Tracker
// Strictly audited against Recruitment_Hiring_Tracker_Data_Model specification.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  Manager
  HR
  TeamLead
}

enum ApplicationStatus {
  InProgress
  Hired
  Rejected
  OnHold
}

enum PositionStatus {
  Draft
  Open
  OnHold
  Closed
}

enum InterviewStatus {
  Scheduled
  Completed
  Cancelled
}

enum CandidateSource {
  Referral
  JobBoard
  Agency
  Direct
}

enum RecipientType {
  Candidate
  User
}

enum NotificationType {
  InterviewScheduled
  Rejection
  Offer
  FeedbackReminder
  CommentMention
}

enum NotificationChannel {
  Email
  InApp
}

enum InvitationStatus {
  Pending
  Accepted
  Declined
}

enum OfferApprovalStatus {
  Pending
  Approved
  Rejected
}

// ==========================================
// MODELS
// ==========================================

// 1. User
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  teamId       String?
  team         Team?    @relation("TeamMembers", fields: [teamId], references: [id])
  createdById  String?
  createdBy    User?    @relation("UserCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  // Reverse relations
  createdUsers           User[]                  @relation("UserCreator")
  createdTeams           Team[]                  @relation("TeamCreator")
  createdTemplates       PipelineTemplate[]      @relation("TemplateCreator")
  createdPositions       Position[]              @relation("PositionCreator")
  createdInterviews      Interview[]             @relation("CreatedInterviews")
  interviewerAssignments InterviewerAssignment[]
  feedbacks              Feedback[]              @relation("FeedbackInterviewer")
  auditLogs              AuditLog[]              @relation("AuditActor")
  delegatedAssignments  InterviewerAssignment[]   @relation("DelegatedAssignments")
  requestedOffers       Application[]             @relation("ApplicationOfferRequester")
  approvedOffers        Application[]             @relation("ApplicationOfferApprover")
  internalNotes         ApplicationInternalNote[]
  savedFilters          SavedFilter[]
  createdQuestionSets   QuestionSet[]
  applicationComments   ApplicationComment[]
  commentMentions       CommentMention[]
}

// 2. Team
model Team {
  id          String @id @default(uuid())
  name        String @unique
  createdById String
  createdBy   User   @relation("TeamCreator", fields: [createdById], references: [id])

  members      User[]        @relation("TeamMembers")
  applications Application[]
}

// 3. PipelineTemplate
model PipelineTemplate {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  createdById String
  createdBy   User    @relation("TemplateCreator", fields: [createdById], references: [id])

  positions Position[]
}

// 4. Position
model Position {
  id                 String            @id @default(uuid())
  title              String
  department         String
  description        String
  requiredSkills     String?
  headcount          Int               @default(1)
  status             PositionStatus    @default(Draft)
  pipelineTemplateId String?
  pipelineTemplate   PipelineTemplate? @relation(fields: [pipelineTemplateId], references: [id])
  createdById        String
  createdBy          User              @relation("PositionCreator", fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  stages       Stage[]
  applications Application[]
}

// 5. Stage
model Stage {
  id                    String   @id @default(uuid())
  positionId            String
  position              Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  name                  String
  sequenceOrder         Int
  isGating              Boolean  @default(true)
  feedbackRequiredCount Int      @default(1)

  applications Application[] @relation("CurrentStage")
  interviews   Interview[]
}

// 6. Candidate
model Candidate {
  id          String          @id @default(uuid())
  name        String
  email       String
  phone       String?
  resumeUrl   String?
  linkedInUrl String?
  source      CandidateSource @default(Direct)
  createdAt   DateTime        @default(now())

  applications Application[]
}

// 7. Application
model Application {
  id             String            @id @default(uuid())
  candidateId    String
  candidate      Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  positionId     String
  position       Position          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  currentStageId String
  currentStage   Stage             @relation("CurrentStage", fields: [currentStageId], references: [id])
  assignedTeamId String?
  assignedTeam   Team?             @relation(fields: [assignedTeamId], references: [id])
  status         ApplicationStatus @default(InProgress)
  statusReason   String?
  notes          String?
  createdAt      DateTime          @default(now())
  stageEnteredAt DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  offerApprovalStatus OfferApprovalStatus?
  offerSalaryOffered  Decimal?            @db.Decimal(12, 2)
  offerStartDate      DateTime?
  offerNotes          String?
  offerRequestedById  String?
  offerRequestedBy    User?               @relation("ApplicationOfferRequester", fields: [offerRequestedById], references: [id])
  offerApprovedById   String?
  offerApprovedBy     User?               @relation("ApplicationOfferApprover", fields: [offerApprovedById], references: [id])
  offerDecidedAt      DateTime?

  interviews    Interview[]
  internalNotes ApplicationInternalNote[]
  tags          ApplicationTag[]
  comments      ApplicationComment[]

  @@unique([candidateId, positionId])
}

// 8. Interview
model Interview {
  id              String          @id @default(uuid())
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId         String
  stage           Stage           @relation(fields: [stageId], references: [id])
  scheduledAt     DateTime?
  durationMinutes Int             @default(60)
  location        String?
  meetingLink     String?
  status          InterviewStatus @default(Scheduled)
  createdById     String
  createdBy       User            @relation("CreatedInterviews", fields: [createdById], references: [id])
  questionSetId   String?
  questionSet     QuestionSet?    @relation(fields: [questionSetId], references: [id], onDelete: Restrict)

  assignments InterviewerAssignment[]
  feedbacks   Feedback[]
  notifications Notification[]
}

// 9. InterviewerAssignment
model InterviewerAssignment {
  id                String           @id @default(uuid())
  interviewId       String
  interview         Interview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId     String
  interviewer       User             @relation(fields: [interviewerId], references: [id])
  feedbackSubmitted Boolean          @default(false)
  invitationStatus  InvitationStatus @default(Pending)
  declineReason     String?
  respondedAt       DateTime?
  delegatedToId     String?
  delegatedTo       User?            @relation("DelegatedAssignments", fields: [delegatedToId], references: [id])
  assignedAt        DateTime         @default(now())

  @@unique([interviewId, interviewerId])
}

// 10. Feedback
model Feedback {
  id            String    @id @default(uuid())
  interviewId   String
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId String
  interviewer   User      @relation("FeedbackInterviewer", fields: [interviewerId], references: [id])
  overallRating Decimal?  @db.Decimal(3, 1)
  comments      String?
  submittedAt   DateTime  @default(now())

  criterionScores FeedbackCriterionScore[]

  @@unique([interviewId, interviewerId])
}

// 11. FeedbackCriterionScore
model FeedbackCriterionScore {
  id            String   @id @default(uuid())
  feedbackId    String
  feedback      Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  criterionName String
  weight        Decimal  @default(1.0) @db.Decimal(4, 2)
  score         Decimal  @db.Decimal(4, 2)
}

// 12. Notification
model Notification {
  id            String              @id @default(uuid())
  applicationId String?
  interviewId   String?
  interview     Interview?          @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  recipientType RecipientType
  recipientId   String
  type          NotificationType
  channel       NotificationChannel @default(Email)
  isRead        Boolean             @default(false)
  readAt        DateTime?
  sentAt        DateTime            @default(now())

  @@index([recipientId, isRead])
  @@index([interviewId, recipientId, type])
}

// 13. AuditLog
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  actionType String
  entityType String
  entityId   String
  details    String?
  timestamp  DateTime @default(now())
}

// 14. JobAlertSubscription
model JobAlertSubscription {
  id               String   @id @default(uuid())
  email            String
  department       String?
  keyword          String?
  unsubscribeToken String   @unique @default(uuid())
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([email])
  @@index([isActive])
}

// 15. ApplicationInternalNote
model ApplicationInternalNote {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
}

// 16. ApplicationTag
model ApplicationTag {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  color         String      @default("#3B82F6")
  createdAt     DateTime    @default(now())

  @@unique([applicationId, name])
  @@index([name])
}

// 17. SavedFilter
model SavedFilter {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  filterData Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// 18. QuestionSet
model QuestionSet {
  id          String      @id @default(uuid())
  title       String
  description String?
  category    String      @default("General")
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  questions  Question[]
  interviews Interview[]
}

// 19. Question
model Question {
  id            String      @id @default(uuid())
  questionSetId String
  questionSet   QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  questionText  String
  sequenceOrder Int         @default(0)
  guidance      String?

  @@index([questionSetId])
}

// 20. ApplicationComment
model ApplicationComment {
  id            String           @id @default(uuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User             @relation(fields: [authorId], references: [id])
  content       String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  mentions CommentMention[]
  @@index([applicationId])
}

// 21. CommentMention
model CommentMention {
  id        String             @id @default(uuid())
  commentId String
  comment   ApplicationComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  createdAt DateTime           @default(now())

  @@index([userId])
}
