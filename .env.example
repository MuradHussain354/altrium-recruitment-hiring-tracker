# Root Environment Variables Example
# Copy this file to .env before running the application locally.
# DO NOT COMMIT REAL SECRETS TO GIT.

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL or SQLite for local dev)
DATABASE_URL="postgresql://user:password@localhost:5432/altrium_recruitment?schema=public"

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Sprint 2 Batch 4: Email Outbox & Account Invitations
# (see server/.env.example for full documentation of each variable)
EMAIL_TOKEN_ENCRYPTION_KEY=your_dedicated_32_byte_or_64_hex_email_token_key_change_in_production
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Altrium Careers <onboarding@resend.dev>"
PUBLIC_APP_URL=http://localhost:5173
OUTBOX_SENDING_TIMEOUT_MS=300000
APP_TIMEZONE=Asia/Colombo

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
