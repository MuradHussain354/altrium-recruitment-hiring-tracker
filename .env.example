# Root Environment Variables Example
# Copy this file to .env before running the application locally.
# DO NOT COMMIT REAL SECRETS TO GIT.

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL or SQLite for local dev)
DATABASE_URL="postgresql://user:password@localhost:5432/altrium_recruitment?schema=public"

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
TWO_FACTOR_ENCRYPTION_KEY=your_32_byte_or_64_hex_encryption_key_change_in_production

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
